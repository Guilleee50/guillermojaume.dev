---
import type { Lang } from '../i18n/content';
import { content } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].skills;
---

<section id="skills" class="py-24 border-t border-zinc-800/50">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-cyan-400 text-sm mb-2">{t.tag}</p>
    <h2 class="text-3xl font-bold text-zinc-100 mb-12">{t.title}</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {t.items.map((skill) => (
        <div class="p-5 rounded-xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 transition-colors duration-150">
          <h3 class="text-sm font-semibold text-zinc-100 mb-4">{skill.title}</h3>
          <ul class="space-y-2">
            {skill.items.map((item) => (
              <li class="flex items-start gap-2 text-xs text-zinc-400 leading-relaxed">
                <span class="text-cyan-400 shrink-0 mt-0.5">▸</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
