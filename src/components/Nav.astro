---
import type { Lang } from '../i18n/content';
import { content } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].nav;
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur-sm">
  <div class="mx-auto max-w-5xl px-6 h-14 flex items-center justify-between">
    <a href="/" class="font-mono text-sm text-cyan-400 font-medium tracking-tight">
      guillermojaume.dev
    </a>

    <div class="hidden sm:flex items-center gap-6">
      <nav>
        <ul class="flex items-center gap-6">
          {t.links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-sm text-zinc-400 hover:text-zinc-100 transition-colors duration-150"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-1.5 pl-4 border-l border-zinc-800">
        <a
          href={lang === 'es' ? '/' : '/'}
          class:list={[
            'font-mono text-xs font-medium transition-colors duration-150',
            lang === 'es' ? 'text-zinc-100' : 'text-zinc-500 hover:text-zinc-300',
          ]}
        >
          ES
        </a>
        <span class="text-zinc-700 text-xs">·</span>
        <a
          href={lang === 'en' ? '/en' : '/en'}
          class:list={[
            'font-mono text-xs font-medium transition-colors duration-150',
            lang === 'en' ? 'text-zinc-100' : 'text-zinc-500 hover:text-zinc-300',
          ]}
        >
          EN
        </a>
      </div>
    </div>
  </div>
</header>
