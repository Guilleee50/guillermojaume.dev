---
import type { Lang } from '../i18n/content';
import { content } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].education;

const dotClass: Record<string, string> = {
  current: 'border-cyan-400 bg-cyan-400/20',
  upcoming: 'border-zinc-600 bg-zinc-950',
  completed: 'border-zinc-700 bg-zinc-950',
};
---

<section id="education" class="py-24 border-t border-zinc-800/50">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-cyan-400 text-sm mb-2">{t.tag}</p>
    <h2 class="text-3xl font-bold text-zinc-100 mb-12">{t.title}</h2>

    <div class="relative">
      <div class="absolute left-[5px] top-0 bottom-0 w-px bg-zinc-800 hidden sm:block"></div>

      <div class="space-y-10 sm:pl-8">
        {t.items.map((edu) => (
          <div class="relative">
            <div
              class={`hidden sm:block absolute -left-8 top-1.5 w-3 h-3 rounded-full border-2 ${dotClass[edu.status]}`}
            ></div>

            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-1">
              <h3 class="text-base font-semibold text-zinc-100 max-w-lg">{edu.degree}</h3>
              <span class="font-mono text-xs text-zinc-500 shrink-0 sm:ml-6">{edu.dates}</span>
            </div>

            <p class="text-sm text-zinc-400">{edu.institution}</p>

            {edu.status === 'current' && (
              <span class="inline-flex items-center gap-1.5 mt-1.5 font-mono text-xs text-cyan-400">
                <span class="relative flex h-1.5 w-1.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-cyan-500"></span>
                </span>
                {t.statusLabels.current}
              </span>
            )}
            {edu.status === 'upcoming' && (
              <span class="inline-flex items-center gap-1.5 mt-1.5 font-mono text-xs text-zinc-500">
                {t.statusLabels.upcoming}
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
