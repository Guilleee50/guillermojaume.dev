---
import type { Lang } from '../i18n/content';
import { content } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].about;
---

<section id="about" class="py-24 border-t border-zinc-800/50">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-cyan-400 text-sm mb-2">{t.tag}</p>
    <h2 class="text-3xl font-bold text-zinc-100 mb-10">{t.title}</h2>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-4 text-zinc-400 leading-relaxed">
        {t.paragraphs.map((para) => (
          <p set:html={para} />
        ))}
      </div>

      <div>
        <div class="p-5 rounded-xl bg-zinc-900 border border-zinc-800 font-mono text-sm">
          <p class="text-zinc-600 text-xs mb-4">~/info.json</p>
          <ul class="space-y-3">
            {t.info.map((item) => (
              <li class="flex gap-3">
                <span class="text-cyan-400 shrink-0">{item.key}</span>
                <span class:list={[item.accent ? 'text-cyan-400' : 'text-zinc-400']}>
                  {item.value}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
