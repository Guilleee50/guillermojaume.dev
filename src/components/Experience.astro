---
import type { Lang } from '../i18n/content';
import { content } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].experience;
---

<section id="experience" class="py-24 border-t border-zinc-800/50">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-cyan-400 text-sm mb-2">{t.tag}</p>
    <h2 class="text-3xl font-bold text-zinc-100 mb-12">{t.title}</h2>

    <div class="space-y-12">
      {t.items.map((exp) => (
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-6">
          <div class="sm:col-span-1">
            <p class="font-mono text-xs text-zinc-500 leading-relaxed">
              {exp.start}<br />– {exp.end}
            </p>
            <p class="text-xs text-zinc-600 mt-1">{exp.location}</p>
          </div>

          <div class="sm:col-span-3 sm:pl-6 sm:border-l border-zinc-800">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-lg font-semibold text-zinc-100">{exp.company}</h3>
              <span class="font-mono text-xs text-zinc-500 px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800">
                {exp.type}
              </span>
            </div>
            <p class="text-sm text-zinc-400 mb-5">{exp.role}</p>

            <ul class="space-y-5">
              {exp.bullets.map((b) => (
                <li>
                  <p class="text-sm text-zinc-400 leading-relaxed mb-2">{b.text}</p>
                  <div class="flex flex-wrap gap-1.5">
                    {b.tech.map((t) => (
                      <span class="font-mono text-xs px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-cyan-400">
                        {t}
                      </span>
                    ))}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
